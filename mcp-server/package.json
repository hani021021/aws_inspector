{
  "name": "aws-inspector-mcp-server",
  "version": "0.1.0",
  "description": "Read-only MCP server exposing Amazon Inspector, ECR and OSV data to the remediation agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-ecr": "3.1161.0",
    "@aws-sdk/client-inspector2": "3.1161.0",
    "@aws-sdk/credential-providers": "3.1161.0",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
